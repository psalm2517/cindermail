# What the "Deploy to Cloudflare" button prompts for. Not read at runtime:
# real values are stored encrypted by Cloudflare, set either by the button's
# own flow or with `wrangler secret put <NAME>`.
#
# These live here rather than in wrangler.jsonc's vars so that nothing in the
# repo carries one deployment's domain or limits into someone else's. Secrets
# also survive a deploy, which plaintext dashboard variables do not: anything
# not declared in wrangler.jsonc gets overwritten the next time the Worker is
# uploaded.

# The domain addresses are generated on. Leave it blank to run on mail.tm's
# domain instead, which needs no domain, no DNS, and no Email Routing.
DISPOSABLE_DOMAIN=

# From your Discord application at discord.com/developers/applications.
DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Only needed if ADAPTERS includes "telegram". From @BotFather. This Worker
# only uses it to deliver mail *to* Telegram; the webhook itself is a
# separate Worker (src/telegram-worker.ts, wrangler.telegram.jsonc), which
# needs this same token plus its own TELEGRAM_WEBHOOK_SECRET set there.
TELEGRAM_BOT_TOKEN=

# Optional. Defaults to 5 if unset. See docs/configuration.md for everything
# else that can be tuned this way.
MAX_ACTIVE_ADDRESSES=
